/* From Uiverse.io by sahilxkhadka */
button_Tip {
all: unset;
position: relative;
height: 4em;
width: 4em;
padding: 5px 5px;
border-radius: 10px;

/* 1. Variables por defecto (Gris original) */
--btn-color: #232323;
--btn-text: #ffffff;

/* 2. Cálculo automático del borde/base */
--base-start: color-mix(in srgb, var(--btn-color) 80%, #000);
--base-end: color-mix(in srgb, var(--btn-color) 60%, #000);

background: linear-gradient(180deg, var(--base-start), var(--base-end));
box-shadow: inset -8px 0 8px rgba(0, 0, 0, 0.15),
inset 0 -8px 8px rgba(0, 0, 0, 0.25),
0 0 0 2px rgba(0, 0, 0, 0.75),
10px 20px 25px rgba(0, 0, 0, 0.4);
display: flex;
justify-content: center;
align-items: center;
cursor: pointer;
}

button_Tip::before {
content: "";
position: absolute;
top: 3px;
left: 4px;
bottom: 14px;
right: 12px;

/* 3. Cálculo automático del gradiente superior */
--face-start: var(--btn-color);
--face-end: color-mix(in srgb, var(--btn-color) 82%, #fff);

background: linear-gradient(90deg, var(--face-start), var(--face-end));
border-radius: 10px;
box-shadow: 10px 5px 10px rgba(0, 0, 0, 0.15);
border-left: 1px solid #0004;
border-bottom: 1px solid #0004;
border-top: 1px solid #0009;
}

/* Estilo para el texto */
button_Tip span {
font-size: 1.2rem;
color: var(--btn-text);
position: relative;
margin-top: -8px;
}

/* --- NUEVO: Soporte para iconos SVG --- */
button_Tip svg {
width: 2.6em;
height: 2.6em;
color: var(--btn-text);
/* Hereda el color del texto para el relleno y los trazos */
fill: currentColor;
stroke: currentColor;
position: relative;
margin-top: -8px; /* Desplazamiento idéntico al texto para centrarse en la tecla */
}